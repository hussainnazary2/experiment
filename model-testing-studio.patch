 import { spawn, execSync, ChildProcess } from 'child_process'
 import * as net from 'net'
 import * as http from 'http'
@@ -386,3 +387,16 @@ ipcMain.handle('restart-backend', async () => {
   await startBackend()
   return true
 })
+
+// Save a screen recording produced by the Model Testing Studio to disk.
+// The renderer sends the WebM bytes; the user picks the destination.
+ipcMain.handle('save-recording', async (_event, payload: { filename: string; data: ArrayBuffer }) => {
+  const result = await dialog.showSaveDialog(mainWindow!, {
+    title: 'Save screen recording',
+    defaultPath: payload?.filename || 'gguf-speed-test.webm',
+    filters: [{ name: 'WebM Video', extensions: ['webm'] }],
+  })
+  if (result.canceled || !result.filePath) return null
+  await fs.promises.writeFile(result.filePath, Buffer.from(payload.data))
+  return result.filePath
+})
